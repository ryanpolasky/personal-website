/assets/music/audio/*.mp3
  Content-Type: audio/mpeg

/assets/music/audio/*.wav
  Content-Type: audio/wav

/hdri/*
  Cache-Control: public, max-age=31536000, immutable

# content-hashed by next; safe to cache forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# project screenshots, sprites, audio. not hashed, so no `immutable`: a
# replaced file at the same path still picks up within a day.
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
